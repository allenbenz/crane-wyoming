# Environment file for the crane-wyoming systemd user service.
# Install as ~/.config/crane-wyoming (loaded via EnvironmentFile= in
# crane-wyoming.service). Every setting here can also be passed as a CLI
# flag; a flag on the command line always overrides the matching variable.
#
# Uncomment and edit the variables you need.

# Required: one or more TTS model directories, separated by ';'.
# The first path is the default voice when a client does not request one.
# Use absolute paths: EnvironmentFile= does not do shell-style expansion,
# so '~' or '$HOME' are passed through literally instead of being resolved.
#CRANE_WYOMING_MODEL_PATH=/home/user/.local/share/inference-models/Voxtral-4B-TTS-2603

# TCP port to listen on (default: 10200).
#CRANE_WYOMING_PORT=10200

# Host address to bind to (default: 0.0.0.0).
#CRANE_WYOMING_HOST=0.0.0.0

# Listen address as a URI: tcp://host:port or unix:///path/to/socket.
# Overrides CRANE_WYOMING_HOST/CRANE_WYOMING_PORT when set. Ignored when
# crane-wyoming is started via socket activation (crane-wyoming.socket),
# since systemd provides the listening socket in that case.
#CRANE_WYOMING_URI=unix:///run/user/1000/crane-wyoming/tts.sock

# Force CPU-only inference, disabling CUDA/Metal auto-detection.
#CRANE_WYOMING_CPU=false

# Maximum number of concurrent client connections (default: 16).
#CRANE_WYOMING_MAX_CONNECTIONS=16

# Directory for the on-disk TTS response cache. Omit to disable caching.
# Use an absolute path (see note on CRANE_WYOMING_MODEL_PATH above).
#CRANE_WYOMING_TTS_CACHE_DIR=/home/user/.cache/crane-wyoming

# Maximum size of the TTS cache, e.g. "500M" or "1G" (default: 500M).
#CRANE_WYOMING_TTS_CACHE_MAX_SIZE=500M
